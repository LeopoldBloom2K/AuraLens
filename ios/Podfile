# ios/Podfile (수정된 전체 내용)

platform :ios, '13.0'

# Flutter에서 필요한 기본 Pods를 로드합니다.
require File.join(File.dirname(__FILE__), '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper')

target 'Runner' do
  # [핵심] Google ML Kit 객체 탐지 네이티브 라이브러리
  pod 'GoogleMLKit/ObjectDetection', '3.2.0'

  use_frameworks!
  use_modular_headers!

  # Flutter 플러그인들을 설치합니다.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end